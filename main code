HIGHSCORE_FILE = "highscore.txt"


def load_highscore():
    if os.path.exists(HIGHSCORE_FILE):
        try:
            with open(HIGHSCORE_FILE, "r") as f:
                return int(f.read().strip())
        except:
            return 0
    return 0


def save_highscore(s):
    try:
        with open(HIGHSCORE_FILE, "w") as f:
            f.write(str(s))
    except:
        pass


