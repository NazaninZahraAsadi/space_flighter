#                         STAR
# ============================================================
class Star:
    def __init__(self):
        self.x = random.randint(0, WIDTH)
        self.y = random.randint(0, HEIGHT)
        self.speed = random.uniform(0.5, 3)
        self.size = random.choice([1, 1, 1, 2])
        self.color = random.choice([(150, 150, 180), (200, 200, 255), (255, 255, 255)])

    def update(self):
        self.y += self.speed
        if self.y > HEIGHT:
            self.y = 0
            self.x = random.randint(0, WIDTH)

    def draw(self, surf):
        pygame.draw.circle(surf, self.color, (int(self.x), int(self.y)), self.size)


stars = [Star() for _ in range(80)]


# ============================================================
#                         PARTICLE
# ============================================================
class Particle:
    def __init__(self, x, y, color, speed=3, life=30):
        self.x = x
        self.y = y
        angle = random.uniform(0, math.pi * 2)
        self.vx = math.cos(angle) * random.uniform(1, speed)
        self.vy = math.sin(angle) * random.uniform(1, speed)
        self.color = color
        self.life = life
        self.max_life = life
        self.size = random.randint(2, 4)

    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.vx *= 0.95
        self.vy *= 0.95
        self.life -= 1

    def draw(self, surf):
        if self.life > 0:
            r = max(1, int(self.size * (self.life / self.max_life)))
            pygame.draw.circle(surf, self.color, (int(self.x), int(self.y)), r)


particles = []


def spawn_particles(x, y, color, count=15, speed=4):
    for _ in range(count):
        particles.append(Particle(x, y, color, speed))


# ============================================================
#                         PLAYER
# ============================================================
class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.w = 44
        self.h = 48
        self.frames = []
        self._build_frames()
        self.frame_index = 0
        self.anim_timer = 0
        self.image = self.frames[0]
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH // 2
        self.rect.bottom = HEIGHT - 30

        self.health = 3
        self.max_health = 3
        self.invincible = 0
        self.weapon_level = 1
        self.weapon_timer = 0

    def _build_frames(self):
        for i in range(4):
            surf = pygame.Surface((self.w, self.h), pygame.SRCALPHA)
            pygame.draw.polygon(surf, BLUE, [(22, 0), (0, 42), (44, 42)])
            pygame.draw.polygon(surf, (0, 100, 200), [(22, 5), (4, 40), (40, 40)])
            pygame.draw.circle(surf, CYAN, (22, 20), 7)
            pygame.draw.circle(surf, WHITE, (22, 20), 3)
            pygame.draw.polygon(surf, (0, 80, 180), [(0, 42), (10, 30), (10, 42)])
            pygame.draw.polygon(surf, (0, 80, 180), [(44, 42), (34, 30), (34, 42)])
            flame_len = 8 + (i % 3) * 4
            pygame.draw.polygon(surf, ORANGE,
                [(22, 44 + flame_len), (14, 42), (30, 42)])
            pygame.draw.polygon(surf, YELLOW,
                [(22, 42 + flame_len // 2), (17, 42), (27, 42)])
            self.frames.append(surf)

    def update_anim(self):
        self.anim_timer += 1
        if self.anim_timer >= 5:
            self.anim_timer = 0
            self.frame_index = (self.frame_index + 1) % len(self.frames)
            self.image = self.frames[self.frame_index]

    def move_to(self, tx, ty):
        dx = tx - self.rect.centerx
        dy = ty - self.rect.centery
        self.rect.centerx += dx * 0.35
        self.rect.centery += dy * 0.35
        self.rect.left = max(0, self.rect.left)
        self.rect.right = min(WIDTH, self.rect.right)
        self.rect.top = max(60, self.rect.top)
        self.rect.bottom = min(HEIGHT - 10, self.rect.bottom)

    def take_damage(self):
        if self.invincible > 0:
            return False
        self.health -= 1
        self.invincible = 90
        spawn_particles(self.rect.centerx, self.rect.centery, RED, 25, 5)
        return True


# ============================================================
#                         BULLET
# ============================================================
class Bullet(pygame.sprite.Sprite):
    def __init__(self, x, y, vx=0, vy=-10, color=CYAN):
        super().__init__()
        self.image = pygame.Surface((6, 16), pygame.SRCALPHA)
        pygame.draw.rect(self.image, color, (0, 0, 6, 16))
        pygame.draw.rect(self.image, WHITE, (2, 0, 2, 16))
        self.rect = self.image.get_rect()
        self.rect.centerx = x
        self.rect.centery = y
        self.vx = vx
        self.vy = vy

    def update(self):
        self.rect.x += self.vx
        self.rect.y += self.vy
        if (self.rect.bottom < 0 or self.rect.top > HEIGHT
                or self.rect.right < 0 or self.rect.left > WIDTH):
            self.kill()


# ============================================================
#                         ENEMY
# ============================================================
class Enemy(pygame.sprite.Sprite):
    def __init__(self, kind="normal"):
        super().__init__()
        self.kind = kind
        self.angle = 0
        self.timer = 0
        self.vx = 0

        if kind == "normal":
            color = RED
            self.hp = 1
            self.speed = 2.5
            self.score_value = 1
        elif kind == "fast":
            color = YELLOW
            self.hp = 1
            self.speed = 5
            self.score_value = 2
        elif kind == "tank":
            color = PURPLE
            self.hp = 4
            self.speed = 1.5
            self.score_value = 3
        elif kind == "zigzag":
            color = PINK
            self.hp = 2
            self.speed = 2.5
            self.score_value = 2
            self.vx = random.choice([-1.5, 1.5])
        else:
            color = RED
            self.hp = 1
            self.speed = 2.5
            self.score_value = 1

        self.max_hp = self.hp
        self.base_image = pygame.Surface((40, 40), pygame.SRCALPHA)

        if kind == "tank":
            pygame.draw.rect(self.base_image, color, (2, 8, 36, 24), border_radius=6)
            pygame.draw.rect(self.base_image, (150, 0, 150), (6, 12, 28, 16), border_radius=4)
            pygame.draw.circle(self.base_image, YELLOW, (20, 20), 6)
        elif kind == "fast":
            pygame.draw.polygon(self.base_image, color, [(20, 40), (5, 5), (35, 5)])
            pygame.draw.circle(self.base_image, RED, (20, 15), 5)
        else:
            pygame.draw.polygon(self.base_image, color, [(20, 40), (0, 8), (40, 8)])
            pygame.draw.circle(self.base_image, YELLOW, (20, 18), 5)

        self.image = self.base_image.copy()
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, WIDTH - 40)
        self.rect.y = -40

    def update(self):
        self.timer += 1
        self.rect.y += self.speed

        if self.kind == "normal":
            self.angle = (self.angle + 4) % 360
        elif self.kind == "tank":
            self.angle = (self.angle + 1) % 360
        elif self.kind == "fast":
            self.angle = 0
        elif self.kind == "zigzag":
            self.rect.x += self.vx
            if self.rect.left < 0 or self.rect.right > WIDTH:
                self.vx *= -1
            self.angle = math.sin(self.timer * 0.15) * 20

        if self.kind in ("normal", "tank", "zigzag"):
            rotated = pygame.transform.rotate(self.base_image, self.angle)
            center = self.rect.center
            self.image = rotated
            self.rect = self.image.get_rect(center=center)

        if self.rect.top > HEIGHT:
            self.kill()


# ============================================================
#                         POWER-UP
# ============================================================
class PowerUp(pygame.sprite.Sprite):
    def __init__(self, x, y, kind="health"):
        super().__init__()
        self.kind = kind
        self.timer = 0
        self.size = 24
        self.image = pygame.Surface((self.size, self.size), pygame.SRCALPHA)

        if kind == "health":
            pygame.draw.circle(self.image, GREEN, (12, 12), 12)
            pygame.draw.rect(self.image, WHITE, (10, 5, 4, 14))
            pygame.draw.rect(self.image, WHITE, (5, 10, 14, 4))
        elif kind == "weapon":
            pygame.draw.circle(self.image, ORANGE, (12, 12), 12)
            pygame.draw.polygon(self.image, WHITE, [(12, 4), (8, 12), (16, 12)])
            pygame.draw.rect(self.image, WHITE, (10, 12, 4, 8))

        self.rect = self.image.get_rect(center=(x, y))
        self.vy = 2

    def update(self):
        self.timer += 1
        self.rect.y += self.vy
        if self.timer % 20 < 10:
            self.rect.inflate_ip(1, 1)
        else:
            self.rect.inflate_ip(-1, -1)
        if self.rect.top > HEIGHT:
            self.kill()


# ============================================================
#                         EXPLOSION
# ============================================================
class Explosion(pygame.sprite.Sprite):
    def __init__(self, x, y, big=False):
        super().__init__()
        self.frames = []
        sizes = [25, 45, 60, 45, 25] if big else [12, 22, 30, 20, 10]
        for r in sizes:
            surf = pygame.Surface((r * 2, r * 2), pygame.SRCALPHA)
            pygame.draw.circle(surf, ORANGE, (r, r), r)
            pygame.draw.circle(surf, YELLOW, (r, r), int(r * 0.6))
            pygame.draw.circle(surf, WHITE, (r, r), int(r * 0.25))
            self.frames.append(surf)
        self.index = 0
        self.image = self.frames[0]
        self.rect = self.image.get_rect(center=(x, y))
        self.timer = 0

    def update(self):
        self.timer += 1
        if self.timer % 3 == 0:
            self.index += 1
            if self.index >= len(self.frames):
                self.kill()
            else:
                center = self.rect.center
                self.image = self.frames[self.index]
                self.rect = self.image.get_rect(center=center)


# ============================================================
#                         BOSS (با update اصلاح‌شده)
# ============================================================
class Boss(pygame.sprite.Sprite):
    def __init__(self, level):
        super().__init__()
        self.max_hp = 20 + level * 5
        self.hp = self.max_hp
        self.w = 120
        self.h = 80
        self.base_image = pygame.Surface((self.w, self.h), pygame.SRCALPHA)
        pygame.draw.polygon(self.base_image, (150, 0, 0),
            [(60, 0), (0, 40), (0, 70), (60, 80), (120, 70), (120, 40)])
        pygame.draw.polygon(self.base_image, RED,
            [(60, 10), (15, 45), (60, 65), (105, 45)])
        pygame.draw.circle(self.base_image, YELLOW, (40, 35), 8)
        pygame.draw.circle(self.base_image, YELLOW, (80, 35), 8)
        pygame.draw.circle(self.base_image, WHITE, (40, 35), 3)
        pygame.draw.circle(self.base_image, WHITE, (80, 35), 3)
        pygame.draw.circle(self.base_image, CYAN, (60, 55), 10)
        pygame.draw.circle(self.base_image, WHITE, (60, 55), 4)

        self.image = self.base_image
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH // 2
        self.rect.y = -100

        self.speed = 1.5
        self.direction = 1
        self.timer = 0
        self.shoot_timer = 0
        self.entering = True
        self.score_value = 10

    def update(self):
        self.timer += 1

        if self.entering:
            self.rect.y += 2

            if self.rect.y >= 20:
                self.entering = False

            return

        center_y = self.rect.centery

        self.rect.x += self.speed * self.direction

        if self.rect.left <= 0:
            self.rect.left = 0
            self.direction = 1

        elif self.rect.right >= WIDTH:
            self.rect.right = WIDTH
            self.direction = -1

        if self.timer % 30 < 15:
            self.image = pygame.transform.scale(
                self.base_image,
                (int(self.w * 1.05), int(self.h * 1.05))
            )
        else:
            self.image = self.base_image

        self.rect = self.image.get_rect(
            center=(self.rect.centerx, center_y)
        )

    def shoot(self):
        bullets = []
        for dx in [-25, 0, 25]:
            b = Bullet(self.rect.centerx + dx, self.rect.bottom, 0, 6, RED)
            b.image = pygame.Surface((10, 14), pygame.SRCALPHA)
            pygame.draw.circle(b.image, RED, (5, 7), 5)
            pygame.draw.circle(b.image, YELLOW, (5, 7), 2)
            bullets.append(b)
        return bullets


# ============================================================
#                         GAME STATE
# ============================================================
STATE_MENU, STATE_PLAYING, STATE_GAMEOVER = "menu", "playing", "gameover"
state = STATE_MENU

highscore = load_highscore()

player = None
all_sprites = pygame.sprite.Group()
enemies = pygame.sprite.Group()
bullets = pygame.sprite.Group()
powerups = pygame.sprite.Group()
boss_group = pygame.sprite.Group()
enemy_bullets = pygame.sprite.Group()

score = 0
shoot_timer = 0
SHOOT_COOLDOWN = 10
diff_timer = 0
diff_level = 1
boss_active = False
boss_spawned_level = 0

touch_active = False
touch_x = 0
touch_y = 0

shake_timer = 0
shake_intensity = 0


def start_new_game():
    global player, all_sprites, enemies, bullets, powerups, boss_group, enemy_bullets
    global score, shoot_timer, diff_timer, diff_level, boss_active, boss_spawned_level
    global particles, shake_timer, shake_intensity

    player = Player()
    all_sprites = pygame.sprite.Group(player)
    enemies = pygame.sprite.Group()
    bullets = pygame.sprite.Group()
    powerups = pygame.sprite.Group()
    boss_group = pygame.sprite.Group()
    enemy_bullets = pygame.sprite.Group()

    score = 0
    shoot_timer = 0
    diff_timer = 0
    diff_level = 1
    boss_active = False
    boss_spawned_level = 0
    particles.clear()
    shake_timer = 0
    shake_intensity = 0


def shoot():
    global shoot_timer
    if shoot_timer < SHOOT_COOLDOWN:
        return
    cx = player.rect.centerx
    cy = player.rect.top

    if player.weapon_level == 1:
        b = Bullet(cx, cy, 0, -11, CYAN)
        all_sprites.add(b); bullets.add(b)
    elif player.weapon_level == 2:
        for dx in [-8, 8]:
            b = Bullet(cx + dx, cy, 0, -11, CYAN)
            all_sprites.add(b); bullets.add(b)
    else:
        for dx, vx in [(-10, -2), (0, 0), (10, 2)]:
            b = Bullet(cx + dx, cy, vx, -11, YELLOW)
            all_sprites.add(b); bullets.add(b)

    shoot_timer = 0
    spawn_particles(cx, cy, CYAN, 4, 2)


def trigger_shake(intensity=8, duration=15):
    global shake_timer, shake_intensity
    shake_intensity = intensity
    shake_timer = duration


# ============================================================
#                         MAIN LOOP
# ============================================================
running = True

while running:
    clock.tick(60)

    # ---------- رویدادها ----------
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.MOUSEBUTTONDOWN:
            if state == STATE_MENU:
                start_new_game()
                state = STATE_PLAYING
            elif state == STATE_PLAYING:
                touch_active = True
                touch_x, touch_y = event.pos
                shoot()
            elif state == STATE_GAMEOVER:
                start_new_game()
                state = STATE_PLAYING

        elif event.type == pygame.MOUSEMOTION:
            if state == STATE_PLAYING and touch_active:
                touch_x, touch_y = event.pos

        elif event.type == pygame.MOUSEBUTTONUP:
            touch_active = False

    # ---------- به‌روزرسانی ----------
    for s in stars:
        s.update()

    if state == STATE_PLAYING:
        player.update_anim()

        if touch_active:
            player.move_to(touch_x, touch_y)
            shoot()

        if shoot_timer < SHOOT_COOLDOWN:
            shoot_timer += 1

        if player.invincible > 0:
            player.invincible -= 1

        if player.weapon_timer > 0:
            player.weapon_timer -= 1
            if player.weapon_timer == 0:
                player.weapon_level = 1
                spawn_particles(player.rect.centerx, player.rect.centery, ORANGE, 10, 3)

        diff_timer += 1
        if diff_timer >= 300:
            diff_timer = 0
            diff_level += 1

        if not boss_active:
            spawn_chance = max(80 - diff_level * 4, 15)
            if random.randint(1, spawn_chance) == 1:
                r = random.random()
                if diff_level >= 4 and r < 0.15:
                    kind = "tank"
                elif diff_level >= 2 and r < 0.40:
                    kind = "fast"
                elif diff_level >= 3 and r < 0.60:
                    kind = "zigzag"
                else:
                    kind = "normal"

                e = Enemy(kind)
                e.speed += diff_level * 0.2
                all_sprites.add(e)
                enemies.add(e)

        if diff_level // 5 > boss_spawned_level and not boss_active:
            boss_spawned_level = diff_level // 5
            boss = Boss(diff_level)
            boss_group.add(boss)
            all_sprites.add(boss)
            boss_active = True
            trigger_shake(10, 30)

        enemies.update()
        boss_group.update()

        if boss_active:
            for boss in boss_group:
                boss.shoot_timer += 1
                if boss.shoot_timer >= 70 and not boss.entering:
                    boss.shoot_timer = 0
                    for b in boss.shoot():
                        all_sprites.add(b)
                        enemy_bullets.add(b)

        bullets.update()
        enemy_bullets.update()

        for p in powerups:
            p.update()

        for p in particles[:]:
            p.update()
            if p.life <= 0:
                particles.remove(p)

        # ---------- برخوردها ----------
        hits = pygame.sprite.groupcollide(enemies, bullets, False, True)
        for enemy, blist in hits.items():
            enemy.hp -= 1
            spawn_particles(enemy.rect.centerx, enemy.rect.centery, YELLOW, 5, 3)
            if enemy.hp <= 0:
                big = enemy.kind in ("tank",)
                expl = Explosion(enemy.rect.centerx, enemy.rect.centery, big)
                all_sprites.add(expl)
                spawn_particles(enemy.rect.centerx, enemy.rect.centery, ORANGE, 15, 4)

                score += enemy.score_value

                r = random.random()
                if r < 0.12:
                    p = PowerUp(enemy.rect.centerx, enemy.rect.centery, "health")
                    all_sprites.add(p); powerups.add(p)
                elif r < 0.22:
                    p = PowerUp(enemy.rect.centerx, enemy.rect.centery, "weapon")
                    all_sprites.add(p); powerups.add(p)

                enemy.kill()

        boss_hits = pygame.sprite.groupcollide(boss_group, bullets, False, True)
        for boss, blist in boss_hits.items():
            boss.hp -= 1
            spawn_particles(boss.rect.centerx + random.randint(-40, 40),
                          boss.rect.centery + random.randint(-20, 20), YELLOW, 3, 3)
            if boss.hp <= 0:
                boss_active = False
                score += boss.score_value
                trigger_shake(20, 50)
                for _ in range(8):
                    ex = boss.rect.centerx + random.randint(-60, 60)
                    ey = boss.rect.centery + random.randint(-40, 40)
                    e2 = Explosion(ex, ey, True)
                    all_sprites.add(e2)
                spawn_particles(boss.rect.centerx, boss.rect.centery, ORANGE, 60, 10)
                for _ in range(2):
                    p = PowerUp(boss.rect.centerx + random.randint(-30, 30),
                                boss.rect.centery, random.choice(["health", "weapon"]))
                    all_sprites.add(p); powerups.add(p)
                boss.kill()

        enemy_bullet_hits = pygame.sprite.spritecollide(player, enemy_bullets, True)
        for _ in enemy_bullet_hits:
            if player.take_damage():
                trigger_shake(10, 15)
                if player.health <= 0:
                    if score > highscore:
                        highscore = score
                        save_highscore(highscore)
                    spawn_particles(player.rect.centerx, player.rect.centery, BLUE, 40, 6)
                    state = STATE_GAMEOVER
                    break

        if state == STATE_PLAYING:
            player_hits = pygame.sprite.spritecollide(player, enemies, True)
            for _ in player_hits:
                if player.take_damage():
                    trigger_shake(12, 20)
                    if player.health <= 0:
                        if score > highscore:
                            highscore = score
                            save_highscore(highscore)
                        spawn_particles(player.rect.centerx, player.rect.centery, BLUE, 40, 6)
                        state = STATE_GAMEOVER
                        break

        if state == STATE_PLAYING and boss_active:
            boss_collide = pygame.sprite.spritecollide(player, boss_group, False)
            if boss_collide and player.take_damage():
                trigger_shake(15, 25)
                if player.health <= 0:
                    if score > highscore:
                        highscore = score
                        save_highscore(highscore)
                    state = STATE_GAMEOVER

        if state == STATE_PLAYING:
            collected = pygame.sprite.spritecollide(player, powerups, True)
            for p in collected:
                if p.kind == "health":
                    if player.health < player.max_health:
                        player.health += 1
                    spawn_particles(p.rect.centerx, p.rect.centery, GREEN, 15, 3)
                elif p.kind == "weapon":
                    player.weapon_level = min(3, player.weapon_level + 1)
                    player.weapon_timer = 600
                    spawn_particles(p.rect.centerx, p.rect.centery, ORANGE, 15, 3)

    # ---------- رسم ----------
    offset_x = offset_y = 0
    if shake_timer > 0:
        shake_timer -= 1
        offset_x = random.randint(-shake_intensity, shake_intensity)
        offset_y = random.randint(-shake_intensity, shake_intensity)

    screen.fill((5, 5, 15))

    game_surface = pygame.Surface((WIDTH, HEIGHT))
    game_surface.fill((5, 5, 15))
    for s in stars:
        s.draw(game_surface)

    if state == STATE_PLAYING:
        for p in particles:
            p.draw(game_surface)

        powerups.draw(game_surface)
        bullets.draw(game_surface)
        enemy_bullets.draw(game_surface)
        enemies.draw(game_surface)
        boss_group.draw(game_surface)

        if player.invincible > 0:
            if player.invincible % 10 < 5:
                game_surface.blit(player.image, player.rect)
        else:
            game_surface.blit(player.image, player.rect)

        # HUD - نوار جان
        for i in range(player.max_health):
            x = 10 + i * 30
            y = 10
            if i < player.health:
                pygame.draw.rect(game_surface, RED, (x, y, 22, 22), border_radius=4)
                pygame.draw.rect(game_surface, (255, 150, 150), (x + 3, y + 3, 6, 6))
            else:
                pygame.draw.rect(game_surface, GRAY, (x, y, 22, 22), border_radius=4)
            pygame.draw.rect(game_surface, WHITE, (x, y, 22, 22), 2, border_radius=4)

        score_txt = font_med.render(f"{score}", True, WHITE)
        game_surface.blit(score_txt, (WIDTH - score_txt.get_width() - 10, 10))

        diff_txt = font_small.render(f"LV {diff_level}", True, YELLOW)
        game_surface.blit(diff_txt, (10, 40))

        hs_txt = font_tiny.render(f"Best: {highscore}", True, GREEN)
        game_surface.blit(hs_txt, (WIDTH - hs_txt.get_width() - 10, 40))

        if player.weapon_timer > 0:
            w_txt = font_tiny.render(f"POWER x{player.weapon_level}", True, ORANGE)
            game_surface.blit(w_txt, (WIDTH // 2 - w_txt.get_width() // 2, 42))
            bar_w = 100
            bar_x = WIDTH // 2 - bar_w // 2
            bar_y = 60
            pygame.draw.rect(game_surface, GRAY, (bar_x, bar_y, bar_w, 5))
            pygame.draw.rect(game_surface, ORANGE,
                (bar_x, bar_y, int(bar_w * player.weapon_timer / 600), 5))

        if boss_active:
            for boss in boss_group:
                bar_w = WIDTH - 40
                bar_x = 20
                bar_y = 80
                pygame.draw.rect(game_surface, (60, 0, 0), (bar_x, bar_y, bar_w, 12), border_radius=6)
                hp_ratio = max(0, boss.hp / boss.max_hp)
                pygame.draw.rect(game_surface, RED,
                    (bar_x, bar_y, int(bar_w * hp_ratio), 12), border_radius=6)
                pygame.draw.rect(game_surface, WHITE, (bar_x, bar_y, bar_w, 12), 2, border_radius=6)
                boss_label = font_tiny.render("BOSS", True, YELLOW)
                game_surface.blit(boss_label, (bar_x, bar_y - 18))

        screen.blit(game_surface, (offset_x, offset_y))

    elif state == STATE_MENU:
        title = font_big.render("SPACE", True, BLUE)
        screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 100))
        title2 = font_big.render("FIGHTER", True, CYAN)
        screen.blit(title2, (WIDTH // 2 - title2.get_width() // 2, 150))

        pulse = int(3 * math.sin(pygame.time.get_ticks() * 0.005))
        start_txt = font_med.render("TAP TO START", True, GREEN)
        screen.blit(start_txt, (WIDTH // 2 - start_txt.get_width() // 2, 320 + pulse))

        lines = [
            "Drag finger = Move",
            "Hold finger = Shoot",
            "Collect items for power-ups",
            "",
            f"High Score: {highscore}"
        ]
        for i, line in enumerate(lines):
            color = YELLOW if i == len(lines) - 1 else WHITE
            txt = font_small.render(line, True, color)
            screen.blit(txt, (WIDTH // 2 - txt.get_width() // 2, 430 + i * 32))

    elif state == STATE_GAMEOVER:
        go = font_big.render("GAME OVER", True, RED)
        screen.blit(go, (WIDTH // 2 - go.get_width() // 2, 180))

        s = font_med.render(f"Score: {score}", True, WHITE)
        screen.blit(s, (WIDTH // 2 - s.get_width() // 2, 280))

        if score >= highscore and score > 0:
            if pygame.time.get_ticks() % 600 < 300:
                new_txt = font_med.render("NEW RECORD", True, YELLOW)
                screen.blit(new_txt, (WIDTH // 2 - new_txt.get_width() // 2, 340))

        h = font_med.render(f"Best: {highscore}", True, GREEN)
        screen.blit(h, (WIDTH // 2 - h.get_width() // 2, 400))

        pulse = int(3 * math.sin(pygame.time.get_ticks() * 0.005))
        p = font_small.render("TAP TO PLAY AGAIN", True, GREEN)
        screen.blit(p, (WIDTH // 2 - p.get_width() // 2, 480 + pulse))

    pygame.display.update()

pygame.quit()